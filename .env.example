# Admin login. The password is only read on the first start (min. 12 characters):
# log in once, then delete the line and run `docker compose up -d` again.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Optional short environment/host name shown in the top bar, e.g. tshetzner01.
# INSTANCE_LABEL=

# Your Caddyfile on the host and the name of Caddy's /config volume.
CADDY_CADDYFILE=/opt/caddy/Caddyfile
CADDY_CONFIG_VOLUME=caddy_caddy_config

# Plain HTTP at http://SERVER-IP:3000. Only in a trusted network.
ALLOW_INSECURE_LAN_HTTP=true
# Address to listen on: 0.0.0.0 (all), one IP of the server, or 127.0.0.1.
BIND_ADDRESS=0.0.0.0

# Only behind a reverse proxy that authenticates every request (README, "Login
# by a reverse proxy"); needs BIND_ADDRESS=127.0.0.1 and no ADMIN_* lines.
# AUTH_DISABLED=true

# Certificates of internal sites (split DNS, private addresses) are only checked
# for these domains and their subdomains, e.g. home.example.com,lan
# CERT_CHECK_PRIVATE_DOMAINS=

TZ=Europe/Berlin
