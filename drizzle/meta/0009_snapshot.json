        "caddy_sites_tls_check": {
          "name": "caddy_sites_tls_check",
          "value": "\"caddy_sites\".\"tls\" in ('automatic', 'off')"
        },
        "caddy_sites_enabled_check": {
          "name": "caddy_sites_enabled_check",
          "value": "\"caddy_sites\".\"enabled\" in (0, 1)"
        },
        "caddy_sites_kind_check": {
          "name": "caddy_sites_kind_check",
          "value": "(\"caddy_sites\".\"kind\" = 'proxy' and \"caddy_sites\".\"upstream\" is not null and \"caddy_sites\".\"redirect_target\" is null and \"caddy_sites\".\"redirect_code\" is null) or (\"caddy_sites\".\"kind\" = 'redirect' and \"caddy_sites\".\"upstream\" is null and \"caddy_sites\".\"redirect_target\" is not null and \"caddy_sites\".\"redirect_code\" in (301, 302, 307, 308) and \"caddy_sites\".\"basic_auth_hash\" is null)"
        },
        "caddy_sites_upstream_skip_tls_verify_check": {
          "name": "caddy_sites_upstream_skip_tls_verify_check",
          "value": "\"caddy_sites\".\"upstream_skip_tls_verify\" = 0 or (\"caddy_sites\".\"kind\" = 'proxy' and \"caddy_sites\".\"upstream\" like 'https://%')"
        },
        "caddy_sites_basic_auth_check": {
          "name": "caddy_sites_basic_auth_check",
          "value": "(\"caddy_sites\".\"basic_auth_username\" is null) = (\"caddy_sites\".\"basic_auth_hash\" is null) and (\"caddy_sites\".\"basic_auth_hash\" is null or \"caddy_sites\".\"tls\" = 'automatic')"
        }
      }
